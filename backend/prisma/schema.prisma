generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                       Int          @id @default(autoincrement())
  nombre                   String       @unique
  pin                      String
  rol                      Rol
  activo                   Boolean      @default(true)
  createdAt                DateTime     @default(now())
  invitacionesBeneficiario Invitacion[] @relation("Beneficiario")
  invitacionesFirmadas     Invitacion[] @relation("Firmante")
  invitacionesSolicitadas  Invitacion[] @relation("Solicitante")
  logAcciones              LogAccion[]  @relation("UsuarioLog")
  sesiones                 SesionCaja[] @relation("UsuarioSesiones")
  ventas                   Venta[]      @relation("UsuarioVentas")
}

model TipoTicket {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  color           String
  contadorSerie   Int              @default(0)
  productoTickets ProductoTicket[]
  tickets         TicketFisico[]
}

model Producto {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  precio          Decimal          @db.Decimal(10, 2)
  activo          Boolean          @default(true)
  lineasVenta     LineaVenta[]
  productoTickets ProductoTicket[]
}

model ProductoTicket {
  id           Int        @id @default(autoincrement())
  productoId   Int
  tipoTicketId Int
  cantidad     Int        @default(1)
  producto     Producto   @relation(fields: [productoId], references: [id])
  tipoTicket   TipoTicket @relation(fields: [tipoTicketId], references: [id])

  @@unique([productoId, tipoTicketId])
}

model Venta {
  id          Int            @id @default(autoincrement())
  metodoPago  MetodoPago
  taquilla    Int
  usuarioId   Int
  estado      EstadoVenta    @default(ACTIVA)
  timestamp   DateTime       @default(now())
  lineas      LineaVenta[]
  logAcciones LogAccion[]
  tickets     TicketFisico[]
  usuario     Usuario        @relation("UsuarioVentas", fields: [usuarioId], references: [id])
}

model LineaVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  nombreSnapshot String
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  comentario     String?
  producto       Producto @relation(fields: [productoId], references: [id])
  venta          Venta    @relation(fields: [ventaId], references: [id])
}

model TicketFisico {
  id           Int         @id @default(autoincrement())
  tipoTicketId Int
  numeroSerie  Int
  ventaId      Int?
  invitacionId Int?
  taquilla     Int
  esInvitacion Boolean     @default(false)
  timestamp    DateTime    @default(now())
  invitacion   Invitacion? @relation(fields: [invitacionId], references: [id])
  tipoTicket   TipoTicket  @relation(fields: [tipoTicketId], references: [id])
  venta        Venta?      @relation(fields: [ventaId], references: [id])
}

model SesionCaja {
  id        Int       @id @default(autoincrement())
  taquilla  Int
  usuarioId Int
  apertura  DateTime  @default(now())
  cierre    DateTime?
  snapshot  Json?
  usuario   Usuario   @relation("UsuarioSesiones", fields: [usuarioId], references: [id])
}

model Invitacion {
  id             Int            @id @default(autoincrement())
  solicitanteId  Int
  beneficiarioId Int
  firmanteId     Int?
  nCopas         Int
  comentario     String?
  firmado        Boolean        @default(false)
  timestamp      DateTime       @default(now())
  beneficiario   Usuario        @relation("Beneficiario", fields: [beneficiarioId], references: [id])
  firmante       Usuario?       @relation("Firmante", fields: [firmanteId], references: [id])
  solicitante    Usuario        @relation("Solicitante", fields: [solicitanteId], references: [id])
  tickets        TicketFisico[]
}

model LogAccion {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  accion      String
  entidad     String
  entidadId   Int?
  ventaId     Int?
  datoAntes   Json?
  datoDespues Json?
  timestamp   DateTime @default(now())
  usuario     Usuario  @relation("UsuarioLog", fields: [usuarioId], references: [id])
  venta       Venta?   @relation(fields: [ventaId], references: [id])
}

enum Rol {
  ADMIN
  TAQUILLA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum EstadoVenta {
  ACTIVA
  ANULADA
}
